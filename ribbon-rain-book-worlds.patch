diff --git a/src/styles/book.css b/src/styles/book.css
index bdb99fa..77cd088 100644
--- a/src/styles/book.css
+++ b/src/styles/book.css
@@ -427,3 +427,304 @@
     font-size: 43px;
   }
 }
+
+/* Per-world atmosphere */
+.book-world {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  overflow: hidden;
+  color: var(--book-accent);
+  pointer-events: none;
+}
+
+.book-world svg,
+.book-world div {
+  position: absolute;
+}
+
+.book-world svg {
+  stroke: currentColor;
+  stroke-width: 1.25;
+  opacity: 0.2;
+  filter: drop-shadow(0 0 26px rgba(var(--book-rgb), 0.14));
+}
+
+/* NEXUS */
+.book-world__portal {
+  top: 49%;
+  right: 5%;
+  width: clamp(250px, 35vw, 590px);
+  aspect-ratio: 1;
+  border: 1px solid rgba(var(--book-rgb), 0.13);
+  border-radius: 50%;
+  transform: translateY(-50%) rotateX(66deg) rotateZ(-12deg);
+  box-shadow: inset 0 0 70px rgba(var(--book-rgb), 0.035), 0 0 80px rgba(var(--book-rgb), 0.035);
+}
+
+.book-world__portal--two {
+  scale: 0.72;
+  rotate: 19deg;
+  opacity: 0.7;
+}
+
+.book-world__portal--three {
+  scale: 0.43;
+  rotate: -21deg;
+  opacity: 0.48;
+}
+
+.book-world__nodes {
+  top: 49%;
+  right: 5%;
+  width: clamp(250px, 35vw, 590px);
+  aspect-ratio: 1;
+  transform: translateY(-50%);
+}
+
+.book-world__nodes i {
+  --angle: calc(var(--i) * 45deg);
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: var(--book-accent);
+  box-shadow: 0 0 20px var(--book-accent);
+  transform: rotate(var(--angle)) translateX(clamp(105px, 15vw, 245px));
+  opacity: 0.46;
+}
+
+/* SILLAGE */
+.book-world__bottle {
+  top: 14%;
+  right: 4%;
+  width: clamp(150px, 19vw, 310px);
+  opacity: 0.16 !important;
+}
+
+.book-world__molecule {
+  right: 18%;
+  bottom: 6%;
+  width: clamp(210px, 28vw, 480px);
+  opacity: 0.22 !important;
+}
+
+.book-world__sillage-lines {
+  inset: 0;
+}
+
+.book-world__sillage-lines i {
+  position: absolute;
+  right: -10%;
+  width: 62%;
+  height: 18%;
+  border-top: 1px solid rgba(var(--book-rgb), 0.12);
+  border-radius: 50%;
+  filter: blur(0.2px);
+}
+
+.book-world__sillage-lines i:nth-child(1) { top: 24%; transform: rotate(-9deg); }
+.book-world__sillage-lines i:nth-child(2) { top: 42%; transform: rotate(5deg); opacity: 0.65; }
+.book-world__sillage-lines i:nth-child(3) { top: 62%; transform: rotate(-4deg); opacity: 0.42; }
+
+/* MANIFESTO */
+.book-world__redactions {
+  inset: 0;
+  opacity: 0.22;
+}
+
+.book-world__redactions i {
+  position: absolute;
+  height: 13px;
+  background: rgba(var(--book-rgb), 0.23);
+  transform: rotate(-7deg);
+}
+
+.book-world__redactions i:nth-child(1) { top: 21%; right: 4%; width: 31%; }
+.book-world__redactions i:nth-child(2) { top: 29%; right: 11%; width: 20%; }
+.book-world__redactions i:nth-child(3) { bottom: 28%; left: 8%; width: 28%; }
+.book-world__redactions i:nth-child(4) { bottom: 21%; left: 15%; width: 17%; }
+
+.book-world__poster-shard {
+  padding: 14px 20px;
+  border: 1px solid rgba(var(--book-rgb), 0.16);
+  color: rgba(var(--book-rgb), 0.26);
+  font: 700 clamp(23px, 4vw, 62px)/0.8 var(--sans);
+  letter-spacing: -0.07em;
+  transform: rotate(-10deg);
+}
+
+.book-world__poster-shard--one { top: 18%; right: 7%; }
+.book-world__poster-shard--two { right: 15%; bottom: 13%; transform: rotate(7deg); }
+
+.book-world__mask {
+  top: 42%;
+  right: 15%;
+  width: 150px;
+  height: 190px;
+  border: 1px solid rgba(var(--book-rgb), 0.12);
+  border-radius: 45% 45% 55% 55%;
+  transform: rotate(12deg);
+  opacity: 0.38;
+}
+
+/* HYDRA */
+.book-world__hydra-ring {
+  top: 49%;
+  right: 8%;
+  width: clamp(250px, 35vw, 540px);
+  aspect-ratio: 1;
+  transform: translateY(-50%);
+  border: 1px solid rgba(var(--book-rgb), 0.11);
+  border-radius: 50%;
+}
+
+.book-world__hydra-ring i {
+  --angle: calc(var(--i) * 40deg);
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 10px;
+  height: 10px;
+  border: 1px solid rgba(var(--book-rgb), 0.45);
+  border-radius: 50%;
+  transform: rotate(var(--angle)) translateX(clamp(110px, 16vw, 255px));
+  box-shadow: 0 0 24px rgba(var(--book-rgb), 0.2);
+}
+
+.book-world__hydra-lines {
+  right: 8%;
+  bottom: 3%;
+  width: clamp(220px, 31vw, 480px);
+  opacity: 0.17 !important;
+}
+
+/* LUCIDREAMER */
+.book-world__clock {
+  top: 13%;
+  right: 5%;
+  width: clamp(240px, 34vw, 530px);
+  aspect-ratio: 1;
+  border: 1px solid rgba(var(--book-rgb), 0.12);
+  border-radius: 50%;
+}
+
+.book-world__clock::before,
+.book-world__clock::after {
+  content: '';
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 34%;
+  height: 1px;
+  transform-origin: left center;
+  background: rgba(var(--book-rgb), 0.28);
+}
+
+.book-world__clock::before { transform: rotate(-37deg); }
+.book-world__clock::after { width: 25%; transform: rotate(88deg); }
+
+.book-world__monas {
+  right: 17%;
+  bottom: 0;
+  width: 75px;
+  height: 330px;
+  opacity: 0.22;
+}
+
+.book-world__monas::before {
+  content: '';
+  position: absolute;
+  right: 23px;
+  bottom: 0;
+  left: 23px;
+  height: 270px;
+  background: linear-gradient(to top, rgba(var(--book-rgb), 0.28), rgba(var(--book-rgb), 0.04));
+  clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%);
+}
+
+.book-world__monas i {
+  position: absolute;
+  top: 0;
+  left: 50%;
+  width: 24px;
+  height: 45px;
+  transform: translateX(-50%);
+  border-radius: 50% 50% 45% 45%;
+  background: rgba(var(--book-rgb), 0.36);
+  filter: blur(0.3px);
+}
+
+.book-world__dream-orbit {
+  top: 40%;
+  right: -4%;
+  width: 47vw;
+  height: 22vh;
+  border-top: 1px solid rgba(var(--book-rgb), 0.1);
+  border-radius: 50%;
+  transform: rotate(-13deg);
+}
+
+.book-world__dream-orbit--two { top: 56%; transform: rotate(8deg); opacity: 0.55; }
+
+/* CAPTURE */
+.book-world__aperture {
+  top: 16%;
+  right: 5%;
+  width: clamp(240px, 36vw, 560px);
+  opacity: 0.16 !important;
+}
+
+.book-world__focus-frame {
+  top: 17%;
+  right: 5%;
+  width: clamp(240px, 36vw, 560px);
+  aspect-ratio: 1;
+}
+
+.book-world__focus-frame i {
+  position: absolute;
+  width: 52px;
+  height: 52px;
+  border-color: rgba(var(--book-rgb), 0.24);
+  border-style: solid;
+}
+
+.book-world__focus-frame i:nth-child(1) { top: 0; left: 0; border-width: 1px 0 0 1px; }
+.book-world__focus-frame i:nth-child(2) { top: 0; right: 0; border-width: 1px 1px 0 0; }
+.book-world__focus-frame i:nth-child(3) { right: 0; bottom: 0; border-width: 0 1px 1px 0; }
+.book-world__focus-frame i:nth-child(4) { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
+
+.book-world__timestamp {
+  right: 7%;
+  bottom: 8%;
+  color: rgba(var(--book-rgb), 0.3);
+  font: 500 9px/1 var(--mono);
+  letter-spacing: 0.18em;
+}
+
+@media (max-width: 760px) {
+  .book-world {
+    opacity: 0.62;
+  }
+
+  .book-world__bottle,
+  .book-world__molecule,
+  .book-world__portal,
+  .book-world__nodes,
+  .book-world__hydra-ring,
+  .book-world__hydra-lines,
+  .book-world__clock,
+  .book-world__aperture,
+  .book-world__focus-frame {
+    right: -18%;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .book-world {
+    opacity: 0.45;
+  }
+}
