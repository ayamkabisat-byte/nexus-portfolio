---
import { BOOKS } from '@/data/books';
import { withBase } from '@/lib/urls';

const REEL_BOOKS = [...BOOKS, ...BOOKS];
---

<section class="cover-reel" id="works" data-book-showcase aria-labelledby="cover-reel-title">
  <header class="cover-reel__header">
    <div>
      <span class="eyebrow">SELECTED FICTION / 2026</span>
      <h2 id="cover-reel-title">Featured works.</h2>
    </div>
    <span class="cover-reel__hint" aria-hidden="true">AUTO-MOVING · HOVER TO PAUSE · DOUBLE-CLICK TO ENTER</span>
  </header>

  <div class="cover-reel__viewport" data-showcase-viewport>
    <div class="cover-reel__track" data-showcase-track>
      {REEL_BOOKS.map((book, index) => {
        const clone = index >= BOOKS.length;

        return (
          <a
            class="cover-reel__item"
            href={withBase(`books/${book.slug}/`)}
            style={`--book-accent:${book.accent}; --book-rgb:${book.accentRgb};`}
            data-showcase-card
            data-showcase-link
            data-showcase-slug={book.slug}
            data-cursor-label={`DOUBLE-CLICK ${book.title}`}
            aria-label={clone ? undefined : `Select ${book.title}; double-click to open`}
            aria-hidden={clone ? 'true' : undefined}
            tabindex={clone ? '-1' : undefined}
          >
            <span class="cover-reel__cover">
              <img
                src={withBase(book.cover)}
                alt={clone ? '' : `${book.title} book cover`}
                width="800"
                height="1200"
                loading="eager"
                decoding="async"
              />
              <span class="cover-reel__shine" aria-hidden="true"></span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>
