---
import { BOOKS } from '@/data/books';
import { withBase } from '@/lib/urls';
---

<section class="works" id="works" data-works>
  <div class="works__stage" data-works-stage>
    <div class="works__ambient" aria-hidden="true"></div>
    <div class="works__ring works__ring--one" aria-hidden="true"></div>
    <div class="works__ring works__ring--two" aria-hidden="true"></div>

    <header class="section-heading works__heading">
      <div>
        <span class="eyebrow">SELECTED FICTION / 2026</span>
        <h2>Featured works</h2>
      </div>
      <span class="section-heading__count">{String(BOOKS.length).padStart(2, '0')} WORLDS</span>
    </header>

    <div class="works__background-title" aria-hidden="true" data-works-title>
      FICTION<br />ARCHIVE
    </div>

    <div class="works__deck" data-works-deck>
      {BOOKS.map((book) => (
        <a
          class="work-card"
          href={withBase(`books/${book.slug}/`)}
          style={`--book-accent:${book.accent}; --book-rgb:${book.accentRgb};`}
          data-work-card
          data-cursor-label={`ENTER ${book.title}`}
          aria-label={`Explore ${book.title}`}
        >
          <span class="work-card__frame">
            <span class="work-card__number">{book.number}</span>
            <img src={withBase(book.cover)} alt={`${book.title} book cover`} width="600" height="900" loading="lazy" decoding="async" />
            <span class="work-card__glare"></span>
            <span class="work-card__shade"></span>
          </span>
          <span class="work-card__meta">
            <small>{book.genre}</small>
            <strong>{book.title}</strong>
          </span>
        </a>
      ))}
    </div>

    <div class="works__intro-copy" data-works-intro aria-hidden="true">
      <p>Six stories passing through fractured realities, buried evidence, scent, memory, rage, and power.</p>
      <span>Scroll to assemble the collection</span>
    </div>

    <div class="works__assembled-copy" data-works-assembled aria-hidden="true">
      <span>COLLECTION ASSEMBLED</span>
      <span>Choose a cover to enter its world</span>
    </div>

    <div class="works__progress" aria-hidden="true">
      <span data-works-progress></span>
    </div>
  </div>
</section>
