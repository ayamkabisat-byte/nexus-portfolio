---
import { BOOKS } from '@/data/books';
import { SITE } from '@/config/site';
import { withBase } from '@/lib/urls';

---

<section class="hero" id="home" data-hero>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--one" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--two" aria-hidden="true"></div>

  <div class="hero__meta" data-reveal>
    <span>SPECULATIVE FICTION AUTHOR</span>
    <span>{SITE.location}</span>
  </div>

  <div class="hero__headline" aria-label="Stories Between Worlds" data-hero-title>
    <div class="hero__line hero__line--stories"><span>STORIES</span></div>
    <div class="hero__line hero__line--between"><span>BETWEEN</span></div>
    <div class="hero__line hero__line--worlds"><span>WORLDS</span><em>.</em></div>
  </div>

  <p class="hero__intro" data-reveal>
    Dystopian bureaucracies. Multiversal fugitives. Scent as evidence.
    Stories about identity, power, memory, and the systems that shape us.
  </p>

  <div class="hero__actions" data-reveal>
    <a class="button button--primary" href="#works" data-cursor-label="ENTER ARCHIVE">
      Enter the archive <span aria-hidden="true">↘</span>
    </a>
    <a class="button button--ghost" href={SITE.royalRoad} target="_blank" rel="noreferrer" data-cursor-label="READ NEXUS">
      Read NEXUS <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="hero__object" data-hero-object aria-hidden="true">
    <div class="hero__orbit"></div>
    {BOOKS.slice(0, 4).map((book, index) => (
      <div
        class={`hero__book hero__book--${index + 1}`}
        style={`--book-accent:${book.accent}; --book-rgb:${book.accentRgb};`}
      >
        <img src={withBase(book.cover)} alt="" width="600" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      </div>
    ))}
    <span class="hero__object-code">ARCHIVE / 06 WORLDS</span>
  </div>

  <div class="hero__ticker" aria-hidden="true">
    <div>
      {[...BOOKS, ...BOOKS].map((book) => (
        <span>{book.title}<i>✦</i></span>
      ))}
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>SCROLL TO DESCEND</span>
    <i></i>
  </div>
</section>
