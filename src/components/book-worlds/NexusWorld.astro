---
import CinematicVideo from '@/components/CinematicVideo.astro';
---

<div class="book-world book-world--nexus" aria-hidden="true">
  <CinematicVideo src="video/nexus.mp4" poster="worlds/nexus.webp" className="book-world__cinematic" priority />
  <div class="world-motif world-motif--nexus">
    <span class="nexus-ring nexus-ring--one"></span>
    <span class="nexus-ring nexus-ring--two"></span>
    <span class="nexus-ring nexus-ring--three"></span>
    <span class="nexus-axis nexus-axis--x"></span>
    <span class="nexus-axis nexus-axis--y"></span>
  </div>
</div>
