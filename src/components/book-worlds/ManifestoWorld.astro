---
import CinematicVideo from '@/components/CinematicVideo.astro';
---

<div class="book-world book-world--manifesto" aria-hidden="true">
  <CinematicVideo src="video/manifesto.mp4" poster="worlds/manifesto.webp" className="book-world__cinematic" priority />
  <div class="world-motif world-motif--manifesto">
    <span class="manifesto-stamp">RESTRICTED</span>
    <span class="redaction redaction--one"></span>
    <span class="redaction redaction--two"></span>
    <span class="redaction redaction--three"></span>
    <span class="manifesto-index">03 / DREAM INSURGENCY</span>
  </div>
</div>
