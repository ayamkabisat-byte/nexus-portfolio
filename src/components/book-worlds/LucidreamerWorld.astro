---
import CinematicVideo from '@/components/CinematicVideo.astro';
---

<div class="book-world book-world--lucidreamer" aria-hidden="true">
  <CinematicVideo src="video/lucidreamer.mp4" poster="worlds/lucidreamer.webp" className="book-world__cinematic" priority />
  <div class="world-motif world-motif--lucidreamer">
    <span class="dream-moon"></span>
    <span class="dream-ring dream-ring--one"></span>
    <span class="dream-ring dream-ring--two"></span>
    <span class="dream-tower">TOWER / MONAS</span>
    <span class="dream-clock">01H : 30D</span>
  </div>
</div>
