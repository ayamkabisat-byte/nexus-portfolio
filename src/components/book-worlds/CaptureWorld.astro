---
import CinematicVideo from '@/components/CinematicVideo.astro';
---

<div class="book-world book-world--capture" aria-hidden="true">
  <CinematicVideo src="video/capture.mp4" poster="worlds/capture.webp" className="book-world__cinematic" priority />
  <div class="world-motif world-motif--capture">
    <span class="viewfinder-corner viewfinder-corner--tl"></span>
    <span class="viewfinder-corner viewfinder-corner--tr"></span>
    <span class="viewfinder-corner viewfinder-corner--bl"></span>
    <span class="viewfinder-corner viewfinder-corner--br"></span>
    <span class="capture-reticle"></span>
    <span class="capture-readout">REC / 72H DECAY</span>
  </div>
</div>
