---
import CinematicVideo from '@/components/CinematicVideo.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class={`book-world book-world--${slug}`} aria-hidden="true">
  <CinematicVideo
    src={`video/${slug}.mp4`}
    poster={`worlds/${slug}.webp`}
    className="book-world__cinematic"
    priority
  />
</div>
